    "auth": {
      "name": "ms-auth",
      "baseUrl": "${MS_AUTH_URL}",
      "timeout": 5000,
      "retries": 2,
      "healthPath": "/health"
    },
    "agents": {
      "name": "ms-agents",
      "baseUrl": "${MS_AGENTS_URL}",
      "timeout": 5000,
      "retries": 2,
      "healthPath": "/health"

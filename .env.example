NODE_ENV=development
APP_NAME=BFF-WIDGET
APP_PORT=3000
APP_DEFAULT_LANG=es

INTERNAL_SERVICE_TOKEN=cambiame-por-un-secreto-largo
BFF_JWT_SECRET=change-me

REDIS_HOST=redis-global-gia-dev
REDIS_PORT=6379

BFF_CACHE_ENABLED=true
BFF_CACHE_DEFAULT_TTL=300

MS_AUTH_URL=http://ms-auth-gia-dev:3020
MS_AGENTS_URL=http://ms-agents-gia-dev:3040
MS_CUSTOMERS_URL=http://ms-customers-gia-dev:3000

# Explicit IP/CIDR list of trusted gateway/proxy peers. Empty = trust socket only.
# Never use true, *, or a catch-all subnet for anonymous demo quotas.
TRUSTED_PROXIES=

# Tenant UUID whose enabled demos appear on the public frontoffice (required for catalog)
DEMO_TENANT_ID=

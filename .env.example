NODE_ENV=development
APP_NAME=BFF-WIDGET
APP_PORT=3000
APP_DEFAULT_LANG=es

INTERNAL_SERVICE_TOKEN=cambiame-por-un-secreto-largo
BFF_JWT_SECRET=change-me

REDIS_HOST=redis-global-gia-dev
REDIS_PORT=6379
# Contrasena del Redis compartido. Debe coincidir con la del stack de Redis y
# con la de los demas servicios: si se desalinea, el sintoma es un NOAUTH al
# conectar. Vacia = Redis sin contrasena (solo local aislado).
REDIS_PASSWORD=

BFF_CACHE_ENABLED=true
BFF_CACHE_DEFAULT_TTL=300

MS_AUTH_URL=http://ms-auth-gia-dev:3020
MS_AGENTS_URL=http://ms-agents-gia-dev:3040
MS_CUSTOMERS_URL=http://ms-customers-gia-dev:3000
# SPEC-167 - la segunda puerta del mensaje del widget (ADR-034). CA-020
# escucha en 3150.
MS_LEADS_URL=http://ms-leads-gia-dev:3150
# SPEC-271 - el panel incrustado de GIA Leads (src/widgets/panel-leads). Sólo
# ese módulo los usa: ms-messaging dice qué agente atiende una cuenta de canal
# y ms-audit recibe el rastro (por Redis; aquí sólo se le pregunta la salud).
MS_MESSAGING_URL=http://ms-messaging-gia-dev:3140
MS_AUDIT_URL=http://ms-audit-gia-dev:3100
MS_DOCUMENTS_URL=http://ms-documents-gia-dev:3050
